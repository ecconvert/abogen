# Abogen TTS Audiobook Generator - Docker Container (Windows Compatible)
FROM python:3.11-slim

# Install system dependencies (remove X11 dependencies for Windows compatibility)
RUN apt-get update && apt-get install -y \
    # Audio dependencies
    ffmpeg \
    # Basic system tools
    curl \
    wget \
    # Build dependencies
    build-essential \
    pkg-config \
    # VNC server for GUI access
    tightvncserver \
    xvfb \
    fluxbox \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Install noVNC for web-based GUI access
RUN wget -O- https://github.com/novnc/noVNC/archive/v1.4.0.tar.gz | tar xz -C /opt/ \
    && mv /opt/noVNC-1.4.0 /opt/noVNC \
    && wget -O- https://github.com/novnc/websockify/archive/v0.11.0.tar.gz | tar xz -C /opt/ \
    && mv /opt/websockify-0.11.0 /opt/websockify

# Set environment variables for GUI
ENV DISPLAY=:99
ENV QT_X11_NO_MITSHM=1
ENV QT_GRAPHICSSYSTEM=native

# Create app directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install PyQt5 through pip (more reliable than apt for containers)
RUN pip install PyQt5 PyQt5-tools

# Copy application code
COPY . .

# Create directories for input/output
RUN mkdir -p /app/input /app/output /app/cache /shared

# Set Python path
ENV PYTHONPATH=/app

# Create VNC startup script
RUN echo '#!/bin/bash\n\
export DISPLAY=:99\n\
Xvfb :99 -screen 0 $VNC_RESOLUTION x$VNC_COL_DEPTH &\n\
x11vnc -display :99 -nopw -listen localhost -xkb -ncache 10 -ncache_cr -forever &\n\
fluxbox &\n\
/opt/websockify/run --web /opt/noVNC --target-config /opt/noVNC/vnc.html --listen 5800 --vnc localhost:5900 &\n\
vncserver -kill :99 2>/dev/null || true\n\
vncserver :99 -geometry $VNC_RESOLUTION -depth $VNC_COL_DEPTH -localhost no\n\
python -m abogen.main\n\
' > /start-gui.sh && chmod +x /start-gui.sh

# Create non-root user for security
RUN useradd -m -u 1000 abogen && \
    chown -R abogen:abogen /app /opt/noVNC /opt/websockify
USER abogen

# Expose ports
EXPOSE 5800 5900

# Set default environment variables
ENV VNC_RESOLUTION=1920x1080
ENV VNC_COL_DEPTH=24

# Default command
CMD ["/start-gui.sh"]