# Public Image Environment Configuration for Abogen
# Use when you want to use a public Chatterbox image instead of building locally

# Chatterbox Configuration - Use public image
CHATTERBOX_BUILD_LOCAL=false
CHATTERBOX_IMAGE=bhimrazy/chatterbox-tts:latest

# Abogen Configuration
ABOGEN_DOCKERFILE=Dockerfile
ABOGEN_WEB_PORT=5800
ABOGEN_VNC_PORT=5900

# Platform-neutral settings
DISPLAY=:0
X11_SOCKET_PATH=/tmp/.X11-unix
AUDIO_DEVICE_PATH=/dev/snd
SHARED_PATH=./shared
DEVICES_LIST=[]

# GPU settings
CUDA_VISIBLE_DEVICES=0

# VNC settings
VNC_RESOLUTION=1920x1080
VNC_COL_DEPTH=24