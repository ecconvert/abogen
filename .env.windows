# Windows Environment Configuration for Abogen
# Use with: docker-compose --env-file .env.windows -f docker-compose.unified.yml up

# Chatterbox Configuration
CHATTERBOX_BUILD_LOCAL=true
CHATTERBOX_BUILD_PATH=../chatterbox-tts-server
CHATTERBOX_DOCKERFILE=Dockerfile
CHATTERBOX_IMAGE=ecconvert/chatterbox-tts-server:latest

# Abogen Configuration  
ABOGEN_DOCKERFILE=Dockerfile.windows
ABOGEN_WEB_PORT=5800
ABOGEN_VNC_PORT=5900

# Windows-specific settings (no X11)
DISPLAY=:99
X11_SOCKET_PATH=/dev/null
AUDIO_DEVICE_PATH=/dev/null
SHARED_PATH=./shared
DEVICES_LIST=[]

# GPU settings
CUDA_VISIBLE_DEVICES=0

# VNC settings
VNC_RESOLUTION=1920x1080
VNC_COL_DEPTH=24